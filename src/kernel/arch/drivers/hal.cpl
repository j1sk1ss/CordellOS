#include "x86_h.cpl"

glob function HAL_initialize() -> i0 {
    kprintf(ref "HAL: (");
    i386_gdt_initialize();
    kprintf(ref "GDT\t");

    i386_idt_initialize();
    kprintf(ref "IDT\t");

    i386_isr_initialize();
    kprintf(ref "ISR\t");

    if i386_irq_initialize(); {
        kprintf(ref "IRQ\t");
    }

    TSS_init(0x5 as u32, 0x10 as u32, 0x0 as u32);
    kprintf(ref "TSS)\n");
}