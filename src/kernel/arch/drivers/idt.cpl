#include "idt_h.cpl"

@[section(".bss")] glob arr _idt[256, idt_entry];
@[section(".bss")] glob idt_descriptor _idt_descriptor;

function idt_entry::set(ptr idt_entry self, ptr i0 base, u16 seg_des, u8 flags) -> i0 {
    self.reserved  = 0;
    self.flags     = flags;
    self.segm_sel  = seg_des;
    self.base_low  = ((base as u32) & 0xFFFF) as u16;
    self.base_high = ((base >> 16) & 0xFFFF) as u16;
}

function idt_descriptor::init(ptr idt_descriptor self, ptr idt_entry entry, u16 size) -> i0 {
    self.limit   = size - 1;
    self.pointer = entry;
}

glob function i386_idt_setGate(i32 int, ptr i0 base, u16 seg_des, u8 flags) -> i0 {
    _idt[int].set(base, seg_des, flags);
}

glob function i386_idt_enableGate(i32 int) -> i0 {
    _idt[int].flags |= IDT_FLAG_PRESENT;
}

@[nosection]
@[inline(never)]
function i386_idt_load(u32 table) -> i0 {
    asm(table) {
        "mov eax, %0",
        "lidt [eax]"
    }
}

function i386_idt_initialize() -> i0 {
    _idt_descriptor.init(ref _idt, sizeof(_idt) as u16);
    i386_idt_load(ref _idt_descriptor);
}
