#include "gdt_h.cpl"

@[align(1)]
container gdt_entry {
    u16 limit_low;
    u16 base_low;
    u8  base_middle;
    u8  access;
    u8  flags_limit_high;
    u8  base_high;

    @[self]
    @[inline(model)]
    function set(ptr gdt_entry self, u32 base, u32 limit, u8 access, u8 flags) -> i0 {
        self.limit_low        = _get_limit_low(limit);
        self.base_low         = _get_base_low(base);
        self.base_middle      = _get_base_middle(base);
        self.access           = access;
        self.flags_limit_high = _get_flags_limit_high(limit, flags);
        self.base_high        = _get_base_high(base);
    }
}

@[align(1)]
container gdt_descriptor {
    u16           limit;
    ptr gdt_entry pointer;

    @[self]
    function init(ptr gdt_descriptor self, ptr ptr gdt_entry entries, u16 count) -> i0 {
        self.limit   = count - 1;
        self.pointer = entries;
    }
}

@[section(".bss")] glob arr _gdt[6, gdt_entry];
@[section(".bss")] glob gdt_descriptor _descriptor; 

@[inline(never)]
function i386_gdt_load(ptr gdt_descriptor d, u16 cs, u16 ds) -> i0 {
    asm(d, cs, ds) {
        "mov eax, %0",
        "lgdt [eax]",
        "push %1",
        "push .reload_cs",
        "retf",
        ".reload_cs",
        "mov ds, %2",
        "mov es, %2",
        "mov fs, %2",
        "mov gs, %2",
        "mov ss, %2"
    }
}

glob function i386_gdt_initialize() -> i0 {
    _gdt[0].set(0, 0, 0, 0);
    _gdt[1].set(0, 0xFFFFF,
        (GDT_ACCESS_SEGMENT_PRESENT | GDT_ACCESS_RING0 | GDT_ACCESS_CODE_SEGMENT | GDT_ACCESS_CODE_READABLE) as u8,
        (GDT_FLAG_32BIT | GDT_FLAG_GRANULARITY_4K) as u8);
    _gdt[2].set(0, 0xFFFFF,
        (GDT_ACCESS_SEGMENT_PRESENT | GDT_ACCESS_RING0 | GDT_ACCESS_DATA_SEGMENT | GDT_ACCESS_DATA_WRITABLE) as u8,
        (GDT_FLAG_32BIT | GDT_FLAG_GRANULARITY_4K) as u8);
    _gdt[3].set(0, 0xFFFFF,
        (GDT_ACCESS_SEGMENT_PRESENT | GDT_ACCESS_RING3 | GDT_ACCESS_CODE_SEGMENT | GDT_ACCESS_CODE_READABLE) as u8,
        (GDT_FLAG_32BIT | GDT_FLAG_GRANULARITY_4K) as u8);
    _gdt[4].set(0, 0xFFFFF,
        (GDT_ACCESS_SEGMENT_PRESENT | GDT_ACCESS_RING3 | GDT_ACCESS_DATA_SEGMENT | GDT_ACCESS_DATA_WRITABLE) as u8,
        (GDT_FLAG_32BIT | GDT_FLAG_GRANULARITY_4K) as u8);
    _gdt[5].set(0, 0, GDT_ACCESS_DISCRIPTOR_TSS, 0);
    _descriptor.init(ref _gdt, sizeof(_gdt) - 1);
    i386_gdt_load(ref _descriptor, i386_GDT_CODE_SEGMENT, i386_GDT_DATA_SEGMENT);
}

glob function GDT_set_entry(i32 index, i32 base, i32 limit, u8 access, u8 flags) -> i0 {
    _gdt[index].set(base, limit, access, flags);
}
