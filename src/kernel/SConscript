from SCons.Environment import Environment
from build.utility import glob_recursive

Import('TARGET_ENVIRONMENT')
TARGET_ENVIRONMENT: Environment

env = TARGET_ENVIRONMENT.Clone()
env.Append(
    LINKFLAGS = [
        '-Wl,-T', env.File('linker.ld').srcnode().path,
        '-Wl,-Map=' + env.File('kernel.map').path,
    ],
    CPPPATH = [ 
        env.Dir('.').srcnode(),
        env.Dir('include').srcnode(),
        env['PROJECTDIR'].Dir('src/libs/include')
    ],
    CPLPATH = [
        env.Dir('.').srcnode(),
        env.Dir('include').srcnode(),
        env['PROJECTDIR'].Dir('src/libs/include')
    ],
    ASFLAGS = [
        '-I', env.Dir('.').srcnode(),
        '-I', env.Dir('include').srcnode(),
        '-f', 'elf'
    ]
)

def _without_sources(sources, source_paths):
    excluded = set(env.File(path).srcnode().path for path in source_paths)
    return [source for source in sources if source.srcnode().path not in excluded]

c_sources = glob_recursive(env, '*.c')
cpp_sources = glob_recursive(env, '*.cpp')
asm_sources = glob_recursive(env, '*.asm')
cpl_sources = []

if env.get('enable_cpl', False):
    cpl_sources = glob_recursive(env, '*.cpl')
    asm_sources = _without_sources(asm_sources, [
        'arch/i386/tss_asm.asm',
    ])

objects = env.Object(c_sources + cpp_sources + asm_sources)
if cpl_sources:
    objects += env.CPLObject(cpl_sources)

# Add font processing
font_file = 'font.psf'
font_obj = env.Command(
    'font.o',
    font_file,
    'objcopy -O elf32-i386 -B i386 -I binary $SOURCE $TARGET'
)

# Include the font object in the list of objects
objects.append(font_obj)

Import('libcore')

static_libs = [
    libcore
]

objects = [
    *objects,
    *static_libs
]

kernel = env.Program('kernel.elf', objects)
kernel_stripped = env.Command('kernel-s.elf', kernel, '$STRIP -o $TARGET $SOURCE')

env.Default(kernel_stripped)

Export('kernel')
Export('kernel_stripped')
